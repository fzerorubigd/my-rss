<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
  <head>
    <title>my-rss - Personal Feed Collection</title>
    <docs>http://www.opml.org/spec2</docs>
  </head>
  <body>
    <!-- Feeds added one at a time, on purpose. Deliberately NOT seeded from
         rss.opml.template: its Hacker News and Stack Overflow style firehoses
         are exactly what this reader exists to get away from. -->
    <outline text="Friends" title="Friends">
      <outline text="jadi" title="jadi.net" type="rss"
               xmlUrl="https://jadi.net/feed/"
               htmlUrl="https://jadi.net/"
               category="Friends"/>
    </outline>

    <outline text="Boardgames" title="Boardgames">
      <outline text="BoardGameGeek Blog" title="BoardGameGeek Blog" type="rss"
               xmlUrl="https://boardgamegeek.com/rss/blog/1"
               htmlUrl="https://boardgamegeek.com/blog/1/boardgamegeek-blog"
               category="Boardgames"/>
      <!-- Self-published: the bgg-hotness repo renders each aggregate run as
           Atom entries and commits them to its own `feed` branch, which is
           published through GitHub Pages. This reader only subscribes to the
           URL, exactly as it would to any third-party feed — nothing is
           written into this repo by that job.
           Served over Pages rather than raw.githubusercontent because the raw
           host RATE-LIMITS: it answered 429 on 2026-08-17, and a reader polling
           on a schedule would drop entries silently. Pages also serves the file
           as application/xml instead of text/plain. -->
      <outline text="BGG Hotness Aggregates" title="BGG Hotness Aggregates" type="rss"
               xmlUrl="https://fzero.rubi.gd/bgg-hotness/feed.xml"
               htmlUrl="https://github.com/fzerorubigd/bgg-hotness"
               category="Boardgames"/>
      <!-- Trade press rather than community chatter: industry news and analysis
           (publisher finances, distribution, conventions). The channel title
           element is empty in their feed, so the title here is set by hand. -->
      <outline text="BoardGameWire" title="BoardGameWire" type="rss"
               xmlUrl="https://boardgamewire.com/index.php/feed/"
               htmlUrl="https://boardgamewire.com/"
               category="Boardgames"/>
    </outline>
  </body>
</opml>
